# API 서버 base URL (끝 슬래시 없이. 예: https://api.muffin.ai.kr)
VITE_API_BASE_URL=

# Google OAuth Client ID (Google Cloud Console > 사용자 인증 정보)
# 같은 OAuth 클라이언트의 '승인된 리디렉션 URI'에 {접속 주소}/auth/google/callback 등록 필요
# 예: https://muffin.ai.kr/auth/google/callback, http://localhost:5173/auth/google/callback
VITE_GOOGLE_CLIENT_ID=
